{
  "agents": {
    "captain": {
      "backend": "claude_cli",
      "model": "claude-opus-5-5",
      "timeout": 2400,
      "effort": "high",
      "max_output_tokens": 128000
    },
    "auditor": {
      "backend": "claude_cli",
      "model": "claude-sonnet-5-5"
    },
    "solver": {
      "backend": "aiprover",
      "model": "aiprover",
      "config": "aiprover/aiprover_vista_logged.toml",
      "cli": "AIProver/AIProver_plugin/bin/aiprover",
      "timeout": 5400,
      "max_turns": 200
    }
  },
  "workers": 2,
  "max_repairs": 4,
  "max_replans": 1,
  "max_audit_rounds": 2,
  "lean_parallel": 4,
  "lean_timeout": 300,
  "max_claude_calls": 10,
  "aiprover_lemma_concurrency": 4,
  "aiprover_session_slots": 8,
  "aiprover_handback_after": 3
}
