{
  "agents": {
    "captain": {
      "backend": "claude_cli",
      "model": "claude-sonnet-5-5",
      "timeout": 2400
    },
    "auditor": {
      "backend": "claude_cli",
      "model": "claude-sonnet-5-5"
    },
    "solver": {
      "backend": "aiprover",
      "model": "aiprover",
      "config": "aiprover/aiprover_vista.toml",
      "cli": "AIProver/AIProver_plugin/bin/aiprover",
      "timeout": 1800,
      "max_turns": 60
    }
  },
  "workers": 2,
  "max_repairs": 4,
  "max_replans": 1,
  "max_audit_rounds": 2,
  "lean_parallel": 4,
  "lean_timeout": 300
}
